<?xml version="1.0" encoding="utf-8" ?>
<component name="PlayerScreen" extends="Group">
  <interface>
    <field id="playback" type="assocarray" />
    <field id="exitRequested" type="boolean" alwaysNotify="true" />
    <field id="playbackError" type="string" alwaysNotify="true" />
    <field id="nextPlaybackRequested" type="assocarray" alwaysNotify="true" />
    <field id="nextPlayback" type="assocarray" alwaysNotify="true" />
  </interface>
  <children>
    <Video id="videoNode" width="1280" height="720" enableUI="false" />

    <Group id="playbackInfoGroup" translation="[72,40]" visible="false">
      <Rectangle width="500" height="280" color="#111827" opacity="0.88" />
      <Label translation="[20,14]" width="460" height="28" text="Playback info" color="#F5F5F5" font="font:SmallBoldSystemFont" />
      <Label id="playbackInfoText" translation="[20,50]" width="460" height="180" wrap="true" maxLines="6" color="#D1D5DB" font="font:SmallSystemFont" />
      <Label translation="[20,242]" width="460" height="26" text="Back to close" color="#9CA3AF" font="font:SmallSystemFont" />
    </Group>

    <Group id="streamLoaderGroup" translation="[1100,32]" visible="false">
      <Poster id="streamLoaderRing" width="144" height="144" uri="pkg:/images/buffering/progress-000.png" />
      <Label id="streamLoaderPercentLabel" translation="[8,54]" width="128" height="36" horizAlign="center" vertAlign="center" text="Loading" color="#F5F5F5" font="font:SmallBoldSystemFont" />
    </Group>

    <Group id="resumePromptGroup" translation="[390,214]" visible="false">
      <Rectangle width="500" height="292" color="#111827" opacity="0.96" />
      <Label id="resumePromptTitleLabel" translation="[30,28]" width="440" text="Continue watching?" color="#F5F5F5" />
      <Label id="resumePromptMessageLabel" translation="[30,74]" width="440" color="#D1D5DB" />
      <Group id="resumePromptOptionsHost" translation="[30,126]" />
      <Label id="resumePromptCountdownLabel" translation="[30,246]" width="440" horizAlign="center" color="#9CA3AF" />
    </Group>

    <Group id="bottomRailGroup" translation="[0,400]" visible="false">
      <Rectangle id="bottomRailBackground" width="1280" height="320" color="#101010" opacity="0.84" />
      <Label id="titleLabel" translation="[72,24]" width="860" height="28" color="#F5F5F5" font="font:SmallBoldSystemFont" />
      <Label id="timeLabel" translation="[1030,28]" width="180" height="28" horizAlign="right" color="#D1D5DB" font="font:SmallSystemFont" />
      <Group id="seasonCarouselGroup" translation="[72,54]" visible="false">
        <Label id="seasonCarouselTitleLabel" text="Season" width="180" color="#D1D5DB" />
        <Label id="seasonCarouselLeftChevron" text="&lt;" translation="[-42,52]" width="30" horizAlign="center" color="#D1D5DB" visible="false" />
        <Group id="seasonCarouselHost" translation="[0,28]" />
        <Label id="seasonCarouselRightChevron" text="&gt;" translation="[1138,52]" width="30" horizAlign="center" color="#D1D5DB" visible="false" />
      </Group>
      <Rectangle id="progressFocus" translation="[68,196]" width="1144" height="22" color="#F5F5F5" opacity="0.18" visible="false" />
      <Rectangle id="progressTrack" translation="[72,204]" width="1136" height="6" color="#4B5563" />
      <Rectangle id="progressFill" translation="[72,204]" width="0" height="6" color="#EF4444" />
      <Label id="remainingTimeLabel" width="620" height="28" color="#D1D5DB" font="font:SmallSystemFont" />
      <Label id="seekFeedbackLabel" width="488" height="34" horizAlign="right" color="#F5F5F5" font="font:MediumBoldSystemFont" visible="false" />
      <Group id="controlsHost" translation="[72,234]" />
      <Group id="focusCursor" translation="[72,234]" visible="false">
        <Rectangle width="184" height="48" color="#E5E7EB" opacity="0.22" />
        <Rectangle width="184" height="4" color="#F5F5F5" />
        <Rectangle translation="[0,44]" width="184" height="4" color="#F5F5F5" />
        <Rectangle width="4" height="48" color="#F5F5F5" />
        <Rectangle translation="[180,0]" width="4" height="48" color="#F5F5F5" />
      </Group>
      <Group id="menuPopover" translation="[720,-238]" visible="false">
        <Rectangle id="menuBackground" width="420" height="264" color="#111827" opacity="0.96" />
        <Label id="menuTitleLabel" translation="[18,14]" width="384" color="#D1D5DB" />
        <Group id="menuItemsHost" translation="[18,48]" />
      </Group>
      <Label id="seasonCarouselStatusLabel" translation="[72,286]" width="700" color="#9CA3AF" visible="false" />
      <Label id="statusLabel" translation="[72,286]" width="700" color="#9CA3AF" />
      <Label id="playbackInfoHint" translation="[930,286]" width="278" height="28" horizAlign="right" text="Info: playback details" color="#9CA3AF" font="font:SmallSystemFont" />
    </Group>

    <Group id="nextEpisodePromptGroup" translation="[764,468]" visible="false">
      <Rectangle width="444" height="204" color="#111827" opacity="0.96" />
      <Label id="nextEpisodePromptTitleLabel" translation="[20,16]" width="404" height="28" text="Up next" color="#F5F5F5" font="font:SmallBoldSystemFont" />
      <Label id="nextEpisodePromptMessageLabel" translation="[20,50]" width="404" height="54" wrap="true" maxLines="2" color="#D1D5DB" font="font:SmallSystemFont" />
      <Group id="nextEpisodePromptOptionsHost" translation="[20,112]" />
      <Label id="nextEpisodePromptCountdownLabel" translation="[20,170]" width="404" height="26" horizAlign="right" color="#9CA3AF" font="font:SmallSystemFont" />
    </Group>

    <Timer id="railHideTimer" repeat="false" duration="4" />
    <Timer id="playbackInfoTimer" repeat="true" duration="1" />
    <Timer id="progressTimer" repeat="true" duration="60" />
    <Timer id="statusClearTimer" repeat="false" duration="2.5" />
    <Timer id="resumePromptTimer" repeat="true" duration="1" />
    <Timer id="nextEpisodeCountdownTimer" repeat="true" duration="1" />
    <Timer id="bufferingDebounceTimer" repeat="false" duration="1.2" />
    <Timer id="streamLoaderAnimationTimer" repeat="true" duration="0.1" />
    <Timer id="seekDebounceTimer" repeat="false" duration="0.45" />
    <Timer id="seekSettleTimer" repeat="false" duration="2.5" />
  </children>
  <script type="text/brightscript" uri="pkg:/source/services/PlayerPreferenceStore.brs" />
  <script type="text/brightscript" uri="pkg:/source/services/AppSettingsStore.brs" />
  <script type="text/brightscript" uri="pkg:/components/MediaCardBadges.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/PlayerPlaybackInfo.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/PlayerScreen.brs" />
</component>
